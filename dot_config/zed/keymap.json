// Zed keymap — ported from ~/.config/nvim (LazyVim). Leader = space
//
// Context depth matters: Zed picks the binding whose context matches deepest
// in the focused element's stack. "Editor" beats "Workspace", so anything
// that must override a Zed default has to live at "Editor" depth or deeper.
[
  // ==========================================================================
  // Normal mode
  // ==========================================================================
  // The rename field is a child Editor, but the parent full Editor stays in
  // the dispatch path with vim_mode == normal (the Vim addon has no focus
  // guard), so "!renaming" keeps these off the rename popup — notably tab /
  // shift-tab, which would otherwise cycle buffers mid-rename.
  {
    "context": "Editor && vim_mode == normal && !menu && !renaming",
    "bindings": {
      "backspace": "vim::FirstNonWhitespace", // <BS> -> ^
      "shift-y": ["workspace::SendKeystrokes", "y $"], // Y -> y$
      "x": ["workspace::SendKeystrokes", "\" _ x"], // delete without yanking
      "shift-j": ["workspace::SendKeystrokes", "m z shift-j ` z"], // join, keep cursor

      // buffer cycling (bufferline.nvim)
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem"
    }
  },

  // ==========================================================================
  // Normal + visual
  // ==========================================================================
  {
    "context": "VimControl && !menu",
    "bindings": {
      "+": "vim::Increment",
      "-": "vim::Decrement",
      "ctrl-d": ["vim::ScrollDown", { "center_cursor": true }], // <C-d>zz
      "ctrl-u": ["vim::ScrollUp", { "center_cursor": true }] // <C-u>zz
    }
  },

  // ==========================================================================
  // Visual mode
  // ==========================================================================
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "shift-k": "editor::MoveLineUp",
      "shift-j": "editor::MoveLineDown",
      "<": "editor::Outdent", // stays in visual mode
      ">": "editor::Indent",
      "p": ["workspace::SendKeystrokes", "p g v y"], // re-paste same text
      "ctrl-c": "editor::Copy",
      "space p": ["workspace::SendKeystrokes", "\" _ d shift-p"] // paste, no yank
    }
  },

  // ==========================================================================
  // Treesitter incremental selection (LazyVim: <CR> grow / <BS> shrink).
  // <CR> works from normal mode too (it starts the selection); <BS> is scoped
  // to the visual modes so the normal-mode <BS> -> ^ binding is never shadowed.
  //
  // "mode == full" is load-bearing: picker query editors (command palette,
  // file finder) are Editors with no vim_mode key at all, and gpui evaluates
  // `vim_mode != insert` as TRUE for a missing key — which would steal <CR>.
  //
  // "!renaming" is load-bearing for the same reason at a different depth: the
  // rename field is a child single_line Editor, but `renaming` is set on the
  // *parent* full Editor. <CR> is unbound at the child's depth, so it resolves
  // against the parent, where this rule and Zed's "Editor && renaming" ->
  // editor::ConfirmRename both match. Equal depth means the user keymap wins,
  // which silently ate every rename confirmation.
  // ==========================================================================
  {
    "context": "Editor && mode == full && !menu && !renaming && vim_mode != insert",
    "bindings": {
      "enter": "editor::SelectLargerSyntaxNode"
    }
  },
  {
    "context": "Editor && !menu && (vim_mode == visual || vim_mode == visual_line || vim_mode == visual_block)",
    "bindings": {
      "backspace": "editor::SelectSmallerSyntaxNode"
    }
  },

  // ==========================================================================
  // Leader keys (LazyVim muscle memory)
  //
  // A context matches any node on the dispatch path, not just the focused
  // one. Bare `AcpThread` / `AgentPanel` / `Terminal` therefore stay live
  // while you type in the message editor, an agent-page editor, or a
  // terminal nested in the panel — `space` becomes a pending leader prefix
  // (which-key, then a delay before the character lands).
  //
  // `!Editor && !Terminal` is load-bearing: `!` scans the whole path, so the
  // panel clauses drop out as soon as a text field is focused. Leader still
  // works on the panel chrome (thread list, project panel, …).
  //
  // `!(Editor > Editor)` is the same guard for the code editor. The Vim addon
  // leaves the parent full Editor on the path with vim_mode == normal while a
  // child editor is focused, so without it typing in that child still checks
  // for the leader. `!MessageEditor` keeps the agent composer out even when it
  // is expanded (`mode == full`) and still in normal mode.
  // ==========================================================================
  {
    "context": "((Editor && mode == full && vim_mode == normal && !menu && !MessageEditor && !(Editor > Editor)) || ((EmptyPane || SharedScreen || (ProjectPanel && not_editing) || GitPanel || (OutlinePanel && not_editing) || AgentPanel || AcpThread || ThreadsSidebar) && !Editor && !Terminal && !MessageEditor)) && !renaming",
    "bindings": {
      // find
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f b": "tab_switcher::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space f p": "projects::OpenRecent",
      "space f r": "projects::OpenRecent",
      "space f t": "terminal_panel::ToggleFocus",
      "space f n": "workspace::NewFile",
      "space e": "project_panel::ToggleFocus",
      "space f e": "project_panel::ToggleFocus",

      // search
      "space /": "pane::DeploySearch",
      "space s g": "pane::DeploySearch",
      // Select the word first so seed_search_query_from_cursor ("selection")
      // picks it up — DeploySearch on a bare cursor seeds nothing.
      "space s w": ["workspace::SendKeystrokes", "v i w space /"],
      "space s s": "outline::Toggle",
      "space s shift-s": "project_symbols::Toggle",
      "space s r": "project_symbols::Toggle",
      "space s c": "command_palette::Toggle",
      "space s k": "zed::OpenKeymap",

      // buffers
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space b b": "pane::AlternateFile", // <leader>bb -> last buffer
      "space `": "pane::AlternateFile",
      "space b p": "pane::TogglePinTab",
      "space b shift-p": "pane::CloseCleanItems",

      // code
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c d": "editor::Hover",
      "space c s": "outline::Toggle",
      "space c l": "diagnostics::Deploy",

      // diagnostics
      "space x x": "diagnostics::Deploy",
      "space x l": "zed::OpenLog",

      // toggles (<leader>u* in LazyVim)
      "space u w": "editor::ToggleSoftWrap",
      "space u l": "editor::ToggleLineNumbers",
      "space u h": "editor::ToggleInlayHints",
      "space u b": "editor::ToggleGitBlameInline",
      "space u g": "editor::ToggleSelectedDiffHunks",
      "space u z": "workspace::ToggleZoom",
      "space u m": "editor::ToggleMinimap",
      "space u a": "editor::ToggleEditPrediction",
      "space u d": "editor::ToggleInlineDiagnostics",
      "space u i": "editor::ToggleIndentGuides",
      "space u shift-l": "editor::ToggleRelativeLineNumbers",
      "space u shift-c": "theme_selector::Toggle",

      // git
      "space g g": "git_panel::ToggleFocus",
      "space g b": "editor::ToggleGitBlameInline",
      "space g d": "git::Diff",
      "space g s": "git::ToggleStaged",
      "space g shift-b": "git::Blame",

      // agent panel (the Zed-native equivalent of the AI plugins)
      "space a a": "agent::ToggleFocus",
      "space a n": "agent::NewThread",

      // terminal
      "space t t": "terminal_panel::ToggleFocus",
      "space t n": "workspace::NewTerminal",

      // windows
      "space w v": "pane::SplitRight",
      "space w s": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "space -": "pane::SplitDown",
      "space w d": "pane::CloseActiveItem",
      "space w w": "workspace::ActivateNextPane",
      "space w m": "workspace::ToggleZoom",
      "space w =": "workspace::ResetPaneSizes",

      "space q q": "workspace::CloseWindow"
    }
  },

  // The composer is a child Editor of AgentPanel / AcpThread, so a panel-level
  // `space …` binding stays pending while you type unless each full sequence
  // is unbound at this depth. A bare `"space": null` does not cancel them.
  {
    "context": "MessageEditor > Editor",
    "bindings": {
      "space space": null,
      "space f f": null,
      "space f b": null,
      "space ,": null,
      "space f p": null,
      "space f r": null,
      "space f t": null,
      "space f n": null,
      "space e": null,
      "space f e": null,
      "space /": null,
      "space s g": null,
      "space s w": null,
      "space s s": null,
      "space s shift-s": null,
      "space s r": null,
      "space s c": null,
      "space s k": null,
      "space b d": null,
      "space b o": null,
      "space b b": null,
      "space `": null,
      "space b p": null,
      "space b shift-p": null,
      "space c a": null,
      "space c r": null,
      "space c f": null,
      "space c d": null,
      "space c s": null,
      "space c l": null,
      "space x x": null,
      "space x l": null,
      "space u w": null,
      "space u l": null,
      "space u h": null,
      "space u b": null,
      "space u g": null,
      "space u z": null,
      "space u m": null,
      "space u a": null,
      "space u d": null,
      "space u i": null,
      "space u shift-l": null,
      "space u shift-c": null,
      "space g g": null,
      "space g b": null,
      "space g d": null,
      "space g s": null,
      "space g shift-b": null,
      "space a a": null,
      "space a n": null,
      "space t t": null,
      "space t n": null,
      "space w v": null,
      "space w s": null,
      "space |": null,
      "space -": null,
      "space w d": null,
      "space w w": null,
      "space w m": null,
      "space w =": null,
      "space q q": null
    }
  },

  // ==========================================================================
  // Splits — mirrors the ghostty config.
  //   ctrl+hjkl        goto_split
  //   ctrl+a > hjkl    new_split          ctrl+a > f   toggle_split_zoom
  //   ctrl+a > HJKL    (swap, zed extra)  ctrl+a > x   close_surface
  //                                       ctrl+a > =   equalize_splits
  // ==========================================================================
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      "ctrl-a h": "pane::SplitLeft",
      "ctrl-a j": "pane::SplitDown",
      "ctrl-a k": "pane::SplitUp",
      "ctrl-a l": "pane::SplitRight",

      "ctrl-a f": "workspace::ToggleZoom",
      "ctrl-a x": "pane::CloseActiveItem",
      "ctrl-a =": "workspace::ResetPaneSizes",

      "ctrl-a shift-h": "workspace::SwapPaneLeft",
      "ctrl-a shift-j": "workspace::SwapPaneDown",
      "ctrl-a shift-k": "workspace::SwapPaneUp",
      "ctrl-a shift-l": "workspace::SwapPaneRight"
    }
  },

  // Zed's defaults claim all of these at "Editor" depth, which outranks the
  // "Workspace" block above. Re-point the nav keys and unbind ctrl-a so the
  // split leader above can register as a pending multi-key prefix.
  //   ctrl-h Backspace   ctrl-j JoinLines   ctrl-k KillRingCut
  //   ctrl-l ScrollCursorCenter             ctrl-a MoveToBeginningOfLine
  {
    "context": "Editor && mode == full && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-a": null
    }
  },

  // ==========================================================================
  // Project panel (oil.nvim-ish). Panel stays open after opening a file;
  // close it with <leader>e or <esc>. h/l/<CR> already match Zed's defaults.
  // ==========================================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
      "escape": "project_panel::ToggleFocus",

      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",

      "o": "project_panel::OpenPermanent",
      "shift-enter": "project_panel::Open", // preview tab
      "ctrl-v": "project_panel::OpenSplitVertical",
      "ctrl-s": "project_panel::OpenSplitHorizontal",

      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "shift-h": "project_panel::ToggleHideGitIgnore"
    }
  },

  // ==========================================================================
  // Popup menus. Not in insert mode, so j/k still type while the completion
  // menu is open. ctrl-n/ctrl-p and escape are already Zed defaults, and their
  // default context also covers insert mode, which is where you want them.
  // ==========================================================================
  {
    "context": "Editor && mode == full && menu && vim_mode != insert",
    "bindings": {
      "j": "editor::ContextMenuNext",
      "k": "editor::ContextMenuPrevious",
      "ctrl-d": "editor::ContextMenuLast",
      "ctrl-u": "editor::ContextMenuFirst",
      "g g": "editor::ContextMenuFirst",
      "shift-g": "editor::ContextMenuLast"
    }
  },

  // Pickers (file finder, command palette, tab switcher, ...)
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious"
    }
  },

  // ==========================================================================
  // Terminal. cmd-j (Zed default) toggles the panel; these just let the split
  // navigation keys work from inside a terminal, which they otherwise don't.
  // ==========================================================================
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  // ==========================================================================
  // Search query history on ctrl-n/ctrl-p instead of the arrow keys. Zed binds
  // these to up/down at "> Editor" depth, so the query editor must be the
  // focused element for the context to match. <Esc> already dismisses.
  // ==========================================================================
  {
    "context": "BufferSearchBar > Editor || ProjectSearchBar > Editor",
    "bindings": {
      "ctrl-n": "search::NextHistoryQuery",
      "ctrl-p": "search::PreviousHistoryQuery"
    }
  }
]
