// Zed user settings. Only values that differ from Zed's bundled default.json
// are listed here. Last reconciled against Zed 1.18.1.
//
// Merge rules (crates/settings_content/src/merge_from.rs):
//   * objects/maps merge deeply, per key
//   * plain arrays replace wholesale
//   * `private_files` is an ExtendingVec  -> user entries are appended
//   * `file_scan_exclusions` is a SplicingVec -> `"..."` expands to the defaults
{
  "cli_default_open_behavior": "new_window",
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.6-terra",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "sidebar_side": "right",
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "ask_user": true,
          "write_file": true
        },
        "enable_all_context_servers": false
      },
      "write": {
        "name": "Write",
        "tools": {
          "ask_user": true,
          "write_file": true
        }
      }
    },
    "tool_permissions": {
      "default": "allow"
    }
  },

  "context_servers": {
    "chrome-devtools-mcp-zed": {
      "enabled": false,
      "settings": {}
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": { "context7_api_key": "" }
    }
  },
  "restore_on_startup": "launchpad",

  "theme": "Moonfly",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 15.0,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15
  },

  "active_pane_modifiers": {
    "inactive_opacity": 0.85,
    "border_size": 1.0
  },

  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "on_yank",
    "use_smartcase_find": true
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 300
  },
  "command_aliases": {
    "W": "w",
    "Q": "q",
    "Wq": "wq",
    "WQ": "wq",
    "Qa": "qa"
  },

  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 4,
  "scroll_beyond_last_line": "off",
  "cursor_blink": false,
  "current_line_highlight": "line",
  "tab_size": 2,
  "preferred_line_length": 120,
  "show_wrap_guides": false,
  "use_smartcase_search": true,
  "seed_search_query_from_cursor": "selection",
  "inlay_hints": { "enabled": true },
  "show_signature_help_after_edits": true,
  "format_on_save": "on",
  "code_actions_on_format": {
    "source.fixAll.oxc": true
  },

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "tab_bar": { "show_nav_history_buttons": false },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false
  },

  "project_panel": {
    "dock": "right",
    "default_width": 260,
    "auto_reveal_entries": false
  },
  "git": {
    "inline_blame": { "enabled": false }
  },

  "file_scan_exclusions": [
    "...",
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/node_modules",
    "**/.svelte-kit",
    "**/.venv",
    "**/dist",
    "**/target"
  ],
  "private_files": ["**/.dev.vars*", "**/local.settings.json"],

  "auto_install_extensions": { "oxc": true },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": { "updateImportsOnFileMove": { "enabled": "always" } },
        "javascript": { "updateImportsOnFileMove": { "enabled": "always" } }
      },
      "enable_lsp_tasks": true
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "all",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    }
  },

  "languages": {
    "Markdown": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "Git Commit": {
      "remove_trailing_whitespace_on_save": false,
      "format_on_save": "off"
    },

    "Python": { "tab_size": 4 },
    "Go": { "tab_size": 4 },
    "Makefile": { "hard_tabs": true },

    "CSS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "HTML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "JavaScript": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "TOML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "TSX": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "TypeScript": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "YAML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },

    "GraphQL": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "LESS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "SCSS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "Vue.js": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },

    "JSON": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "JSON5": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "JSONC": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },

    "PowerShell": {
      "formatter": [{ "language_server": { "name": "powershell-es" } }]
    }
  }
}
