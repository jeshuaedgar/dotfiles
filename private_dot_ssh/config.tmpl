Host github.com-work
	HostName github.com
	User git
	IdentityAgent SSH_AUTH_SOCK
	IdentityFile ~/.ssh/github-work.pub
	IdentitiesOnly yes

Host github.com-personal
	HostName github.com
	User git
	IdentityAgent SSH_AUTH_SOCK
	IdentityFile ~/.ssh/github-personal.pub
	IdentitiesOnly yes

Host ssh.dev.azure.com-work
	HostName ssh.dev.azure.com
	User git
	IdentityAgent SSH_AUTH_SOCK
	IdentityFile ~/.ssh/azure-devops-work.pub
	IdentitiesOnly yes

Host ssh.dev.azure.com-admin
	HostName ssh.dev.azure.com
	User git
	IdentityAgent "{{ if eq .chezmoi.os "darwin" }}%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock{{ else }}SSH_AUTH_SOCK{{ end }}"
	IdentityFile ~/.ssh/azure-devops-work-admin.pub
	IdentitiesOnly yes

Host ssh.dev.azure.com
	User git
	IdentityAgent SSH_AUTH_SOCK
	IdentityFile ~/.ssh/azure-devops-work.pub
	IdentitiesOnly yes
